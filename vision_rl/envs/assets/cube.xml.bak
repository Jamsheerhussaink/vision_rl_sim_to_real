<mujoco model="cube">
  <asset>
    <!-- Bright Yellow Cube Material (5cm) -->
    <material name="cube_mat" rgba="0.80 0.58 0.28 1.0" specular="0.05" shininess="0.1"/>
  </asset>

  <worldbody>
    <!-- 5cm Yellow Cube placed on the dark green table (table surface at z=0.40m -> cube center at z=0.425m) -->
    <body name="cube" pos="0.274 -0.128 0.425" quat="0.9915 0 0 -0.1301">
      <freejoint name="cube_joint"/>
      
      <!-- 5cm Cube: half-size 0.025m, mass 40g, high static friction. solref 0.01 = 2x timestep (MJX needs >= 2x) -->
      <geom name="cube_geom" type="box" size="0.025 0.025 0.025" material="cube_mat" 
            mass="0.040"
            contype="1" conaffinity="1" 
            friction="1.4 0.01 0.0005" 
            solref="0.01 1" solimp="0.95 0.99 0.001"/>
    </body>
  </worldbody>
</mujoco>
