<?xml version="1.0" ?>
<!-- ============================================================================== -->
<!-- 5cm Yellow Cube URDF                                                          -->
<!-- Size: 5cm x 5cm x 5cm (0.05m x 0.05m x 0.05m)                                  -->
<!-- Color: Bright Yellow                                                          -->
<!-- Mass: 65 grams                                                                -->
<!-- ============================================================================== -->
<robot name="yellow_cube">

  <material name="cube_yellow">
    <color rgba="0.96 0.85 0.05 1.0"/>
  </material>

  <link name="cube_link">
    <!-- Visual representation -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
      <material name="cube_yellow"/>
    </visual>

    <!-- Collision geometry -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.05"/>
      </geometry>
    </collision>

    <!-- Inertial properties for 5cm cube (0.065 kg) -->
    <inertial>
      <mass value="0.065"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0000271" ixy="0.0" ixz="0.0"
               iyy="0.0000271" iyz="0.0"
               izz="0.0000271"/>
    </inertial>
  </link>

</robot>
