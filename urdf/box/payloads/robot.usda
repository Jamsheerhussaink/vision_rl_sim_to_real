#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "cardboard_box"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "cardboard_box" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = </cardboard_box/Physics/root_joint>
    prepend rel isaac:physics:robotLinks = </cardboard_box/Geometry/box_base_link>
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "box_base_link" (
            prepend apiSchemas = ["IsaacLinkAPI"]
        )
        {
        }
    }

    over "Physics"
    {
        over "root_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

