#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "cardboard_box"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "cardboard_box" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
)
{
    bool newton:selfCollisionEnabled = 0

    over "Geometry"
    {
        over "box_base_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
        )
        {
            double[] newton:inertia = [0.00035, 0.00055, 0.00075, 0, 0, 0]
            point3f physics:centerOfMass = (0, 0, 0.035)
            float3 physics:diagonalInertia = (0.00035, 0.00055, 0.00075)
            float physics:mass = 0.08
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "box_5" (
                prepend apiSchemas = ["NewtonCollisionAPI"]
            )
            {
            }

            over "box_6" (
                prepend apiSchemas = ["NewtonCollisionAPI"]
            )
            {
            }

            over "box_7" (
                prepend apiSchemas = ["NewtonCollisionAPI"]
            )
            {
            }

            over "box_8" (
                prepend apiSchemas = ["NewtonCollisionAPI"]
            )
            {
            }

            over "box_9" (
                prepend apiSchemas = ["NewtonCollisionAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </cardboard_box>
            custom rel physics:body1
            append rel physics:body1 = </cardboard_box/Geometry/box_base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

