#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "sensor_d415"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "sensor_d415" (
    prepend apiSchemas = ["IsaacRobotAPI"]
)
{
    prepend rel isaac:physics:robotJoints = </sensor_d415/Physics/camera_link_joint>
    prepend rel isaac:physics:robotLinks = </sensor_d415/Geometry/camera_bottom_screw_frame/camera_link>
    token isaac:robotType = "Default"

    over "Geometry"
    {
        over "camera_bottom_screw_frame"
        {
            over "camera_link" (
                prepend apiSchemas = ["IsaacLinkAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        over "camera_link_joint" (
            prepend apiSchemas = ["IsaacJointAPI"]
        )
        {
        }
    }
}

