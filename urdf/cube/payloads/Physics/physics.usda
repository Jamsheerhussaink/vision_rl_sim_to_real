#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "yellow_cube"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "yellow_cube" (
    prepend apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
)
{
    bool newton:selfCollisionEnabled = 0

    over "Geometry"
    {
        over "cube_link" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "NewtonMassAPI"]
        )
        {
            double[] newton:inertia = [0.0000271, 0.0000271, 0.0000271, 0, 0, 0]
            point3f physics:centerOfMass = (0, 0, 0)
            float3 physics:diagonalInertia = (0.0000271, 0.0000271, 0.0000271)
            float physics:mass = 0.065
            quatf physics:principalAxes = (1, 0, 0, 0)

            over "box_1" (
                prepend apiSchemas = ["NewtonCollisionAPI"]
            )
            {
            }
        }
    }

    over "Physics"
    {
        def PhysicsFixedJoint "root_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </yellow_cube>
            custom rel physics:body1
            append rel physics:body1 = </yellow_cube/Geometry/cube_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

