#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "green_table"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "green_table"
{
    over "Geometry"
    {
        over "table_base_link"
        {
            over "table_top_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [1.45, 2.05, 3.2, 0, 0, 0]
                bool newton:selfCollisionEnabled = 1
                point3f physics:centerOfMass = (0, 0, -0.1)
                float3 physics:diagonalInertia = (1.45, 2.05, 3.2)
                float physics:mass = 15
                quatf physics:principalAxes = (1, 0, 0, 0)
            }
        }
    }

    over "Physics"
    {
        def PhysicsFixedJoint "table_top_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </green_table>
            custom rel physics:body1
            append rel physics:body1 = </green_table/Geometry/table_base_link/table_top_link>
            point3f physics:localPos0 = (0, 0, 0.385)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

