#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "so101_workspace_scene"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

def Xform "so101_workspace_scene" (
    prepend references = @./payloads/base.usda@
    append variantSets = "Physics"
)
{
    variantSet "Physics" = {
        "none" {

        }
        "physics" (
            prepend payload = @./payloads/Physics/physics.usda@
        ) {

        }
    }
}

over "Flattened_Prototype_15"
{
    def Shader "PreviewSurface"
    {
        uniform token info:id = "UsdPreviewSurface"
        color3f inputs:diffuseColor.connect = </Flattened_Prototype_15.inputs:diffuseColor>
        float inputs:metallic.connect = </Flattened_Prototype_15.inputs:metallic>
        float inputs:opacity.connect = </Flattened_Prototype_15.inputs:opacity>
        float inputs:roughness.connect = </Flattened_Prototype_15.inputs:roughness>
        token outputs:displacement
        token outputs:surface
    }
}

