#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.3.2"
    }
    defaultPrim = "sensor_d415"
    endTimeCode = 1000000
    kilogramsPerUnit = 1
    metersPerUnit = 1
    startTimeCode = 0
    upAxis = "Z"
)

over "sensor_d415"
{
    over "Geometry"
    {
        over "camera_bottom_screw_frame"
        {
            over "camera_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsArticulationRootAPI", "NewtonArticulationRootAPI", "PhysicsMassAPI", "NewtonMassAPI"]
            )
            {
                double[] newton:inertia = [0.00000557, 0.0000608, 0.0000612, 0, 0, 0]
                bool newton:selfCollisionEnabled = 0
                point3f physics:centerOfMass = (0, 0, 0)
                float3 physics:diagonalInertia = (0.00000557, 0.0000608, 0.0000612)
                float physics:mass = 0.072
                quatf physics:principalAxes = (1, 0, 0, 0)

                over "box_2" (
                    prepend apiSchemas = ["NewtonCollisionAPI"]
                )
                {
                }
            }
        }
    }

    over "Physics"
    {
        def PhysicsFixedJoint "camera_link_joint"
        {
            custom rel physics:body0
            append rel physics:body0 = </sensor_d415>
            custom rel physics:body1
            append rel physics:body1 = </sensor_d415/Geometry/camera_bottom_screw_frame/camera_link>
            point3f physics:localPos0 = (0, 0.01, 0.0115)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
        }
    }
}

