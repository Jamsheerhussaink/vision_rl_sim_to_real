<?xml version="1.0" ?>
<!-- ============================================================================== -->
<!-- Cardboard Box URDF                                                            -->
<!-- Specifications:                                                               -->
<!--   Height: 8cm (0.08m)                                                         -->
<!--   Length: 20cm (0.20m)                                                        -->
<!--   Width: 15cm (0.15m)                                                         -->
<!--   Construction: Open-top box with 5 collision walls (bottom + 4 side walls)   -->
<!--   Material: Kraft Cardboard Brown                                             -->
<!--   Mass: ~120 grams                                                            -->
<!-- ============================================================================== -->
<robot name="cardboard_box">

  <material name="cardboard_brown">
    <color rgba="0.74 0.54 0.35 1.0"/>
  </material>

  <material name="cardboard_tape">
    <color rgba="0.88 0.88 0.84 1.0"/>
  </material>

  <link name="box_base_link">
    <!-- 1. Bottom Floor Plate (Length 0.20m x Width 0.15m x Thickness 0.004m) -->
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.15 0.004"/>
      </geometry>
      <material name="cardboard_brown"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.15 0.004"/>
      </geometry>
    </collision>

    <!-- 2. Front Wall (-Y, Length: 0.20m, Height: 0.08m, Thickness: 0.004m) -->
    <visual>
      <origin xyz="0 -0.073 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.004 0.08"/>
      </geometry>
      <material name="cardboard_brown"/>
    </visual>
    <collision>
      <origin xyz="0 -0.073 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.004 0.08"/>
      </geometry>
    </collision>

    <!-- 3. Back Wall (+Y, Length: 0.20m, Height: 0.08m, Thickness: 0.004m) -->
    <visual>
      <origin xyz="0 0.073 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.004 0.08"/>
      </geometry>
      <material name="cardboard_brown"/>
    </visual>
    <collision>
      <origin xyz="0 0.073 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.004 0.08"/>
      </geometry>
    </collision>

    <!-- 4. Left Wall (-X, Width: 0.15m, Height: 0.08m, Thickness: 0.004m) -->
    <visual>
      <origin xyz="-0.098 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.142 0.08"/>
      </geometry>
      <material name="cardboard_brown"/>
    </visual>
    <collision>
      <origin xyz="-0.098 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.142 0.08"/>
      </geometry>
    </collision>

    <!-- 5. Right Wall (+X, Width: 0.15m, Height: 0.08m, Thickness: 0.004m) -->
    <visual>
      <origin xyz="0.098 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.142 0.08"/>
      </geometry>
      <material name="cardboard_brown"/>
    </visual>
    <collision>
      <origin xyz="0.098 0 0.04" rpy="0 0 0"/>
      <geometry>
        <box size="0.004 0.142 0.08"/>
      </geometry>
    </collision>

    <!-- Inertial properties for ~80g open box -->
    <inertial>
      <mass value="0.080"/>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <inertia ixx="0.00035" ixy="0.0" ixz="0.0"
               iyy="0.00055" iyz="0.0"
               izz="0.00075"/>
    </inertial>
  </link>

</robot>
