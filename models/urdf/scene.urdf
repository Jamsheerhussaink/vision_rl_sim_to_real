<?xml version="1.0" ?>
<!-- ============================================================================== -->
<!-- Complete SO-101 Sim-to-Real Workcell Scene URDF                               -->
<!-- Assembles:                                                                     -->
<!--   1. Dark Green Tabletop (1.20m x 1.00m x 0.40m) + 4 Black Legs                -->
<!--   2. SO-101 Robot Arm (5-DOF + Parallel Gripper + Silicone Contact Pads)       -->
<!--   3. Yellow Cube (5cm x 5cm x 5cm, 65g)                                        -->
<!--   4. Cardboard Box (8cm Height x 20cm Length x 15cm Width, 5 Collision Walls)  -->
<!--   5. Intel RealSense D415 RGB Camera (Tri-pod Workspace Mounting)              -->
<!-- ============================================================================== -->
<robot name="so101_workspace_scene">

  <!-- ==================== Materials ==================== -->
  <material name="dark_green_mat">
    <color rgba="0.08 0.22 0.12 1.0"/>
  </material>
  <material name="matte_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="robot_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>
  <material name="sts3215_gray">
    <color rgba="0.22 0.22 0.22 1.0"/>
  </material>
  <material name="yellow_cube_mat">
    <color rgba="0.96 0.85 0.05 1.0"/>
  </material>
  <material name="cardboard_brown">
    <color rgba="0.74 0.54 0.35 1.0"/>
  </material>
  <material name="cardboard_tape">
    <color rgba="0.88 0.88 0.84 1.0"/>
  </material>
  <material name="d415_aluminum">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>
  <material name="d415_lens_glass">
    <color rgba="0.10 0.10 0.15 1.0"/>
  </material>

  <!-- ==================== World Origin ==================== -->
  <link name="world"/>

  <!-- ==================== 1. Table ==================== -->
  <joint name="world_to_table" type="fixed">
    <origin xyz="0 0 0.385" rpy="0 0 0"/>
    <parent link="world"/>
    <child link="table_top_link"/>
  </joint>

  <link name="table_top_link">
    <!-- Tabletop Slab -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.20 1.00 0.03"/>
      </geometry>
      <material name="dark_green_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.20 1.00 0.03"/>
      </geometry>
    </collision>

    <!-- 4 Black Legs -->
    <visual>
      <origin xyz="0.52 0.42 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.37"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0.52 0.42 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.37"/></geometry>
    </collision>

    <visual>
      <origin xyz="0.52 -0.42 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.37"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="0.52 -0.42 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.37"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.52 0.42 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.37"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="-0.52 0.42 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.37"/></geometry>
    </collision>

    <visual>
      <origin xyz="-0.52 -0.42 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.37"/></geometry>
      <material name="matte_black"/>
    </visual>
    <collision>
      <origin xyz="-0.52 -0.42 -0.20" rpy="0 0 0"/>
      <geometry><cylinder radius="0.025" length="0.37"/></geometry>
    </collision>

    <inertial>
      <mass value="15.0"/>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <inertia ixx="1.45" ixy="0" ixz="0" iyy="2.05" iyz="0" izz="3.20"/>
    </inertial>
  </link>

  <!-- ==================== 1b. SO-101 Robot Mount ==================== -->
  <!-- Robot mounted on tabletop at calibrated pos [-0.13, -0.02], yaw = 30 deg -->
  <joint name="table_to_robot" type="fixed">
    <origin xyz="-0.13 -0.02 0.027" rpy="0 0 0.5236"/>
    <parent link="table_top_link"/>
    <child link="base_link"/>
  </joint>

  <!-- ==================== 2. Cardboard Box (8x20x15cm) ==================== -->
  <joint name="table_to_box" type="fixed">
    <origin xyz="0.22 0.25 0.015" rpy="0 0 -0.0873"/>
    <parent link="table_top_link"/>
    <child link="box_base_link"/>
  </joint>

  <link name="box_base_link">
    <!-- Floor Plate -->
    <visual>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry><box size="0.20 0.15 0.004"/></geometry>
      <material name="cardboard_brown"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.002" rpy="0 0 0"/>
      <geometry><box size="0.20 0.15 0.004"/></geometry>
    </collision>

    <!-- Front Wall (-Y) -->
    <visual>
      <origin xyz="0 -0.073 0.04" rpy="0 0 0"/>
      <geometry><box size="0.20 0.004 0.08"/></geometry>
      <material name="cardboard_brown"/>
    </visual>
    <collision>
      <origin xyz="0 -0.073 0.04" rpy="0 0 0"/>
      <geometry><box size="0.20 0.004 0.08"/></geometry>
    </collision>

    <!-- Back Wall (+Y) -->
    <visual>
      <origin xyz="0 0.073 0.04" rpy="0 0 0"/>
      <geometry><box size="0.20 0.004 0.08"/></geometry>
      <material name="cardboard_brown"/>
    </visual>
    <collision>
      <origin xyz="0 0.073 0.04" rpy="0 0 0"/>
      <geometry><box size="0.20 0.004 0.08"/></geometry>
    </collision>

    <!-- Left Wall (-X) -->
    <visual>
      <origin xyz="-0.098 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.004 0.142 0.08"/></geometry>
      <material name="cardboard_tape"/>
    </visual>
    <collision>
      <origin xyz="-0.098 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.004 0.142 0.08"/></geometry>
    </collision>

    <!-- Right Wall (+X) -->
    <visual>
      <origin xyz="0.098 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.004 0.142 0.08"/></geometry>
      <material name="cardboard_brown"/>
    </visual>
    <collision>
      <origin xyz="0.098 0 0.04" rpy="0 0 0"/>
      <geometry><box size="0.004 0.142 0.08"/></geometry>
    </collision>

    <inertial>
      <mass value="0.080"/>
      <origin xyz="0 0 0.035" rpy="0 0 0"/>
      <inertia ixx="0.00035" ixy="0" ixz="0" iyy="0.00055" iyz="0" izz="0.00075"/>
    </inertial>
  </link>

  <!-- ==================== 3. Yellow Cube (5cm) ==================== -->
  <joint name="table_to_cube" type="floating">
    <origin xyz="0.16 -0.01 0.040" rpy="0 0 0"/>
    <parent link="table_top_link"/>
    <child link="cube_link"/>
  </joint>

  <link name="cube_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
      <material name="yellow_cube_mat"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.05 0.05 0.05"/></geometry>
    </collision>
    <inertial>
      <mass value="0.065"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="2.71e-05" ixy="0" ixz="0" iyy="2.71e-05" iyz="0" izz="2.71e-05"/>
    </inertial>
  </link>

  <!-- ==================== 4. Intel RealSense D415 RGB Camera ==================== -->
  <joint name="world_to_camera" type="fixed">
    <origin xyz="0.12 -0.38 0.82" rpy="0 0.7418 1.3416"/>
    <parent link="world"/>
    <child link="camera_link"/>
  </joint>

  <link name="camera_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.099 0.020 0.023"/></geometry>
      <material name="d415_aluminum"/>
    </visual>
    <visual>
      <origin xyz="0 0.0105 0" rpy="0 0 0"/>
      <geometry><box size="0.088 0.002 0.016"/></geometry>
      <material name="d415_lens_glass"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry><box size="0.099 0.020 0.023"/></geometry>
    </collision>
    <inertial>
      <mass value="0.072"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="5.57e-06" ixy="0" ixz="0" iyy="6.08e-05" iyz="0" izz="6.12e-05"/>
    </inertial>
  </link>

  <!-- Optical Frames -->
  <joint name="camera_color_joint" type="fixed">
    <origin xyz="0.015 0.011 0" rpy="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_color_optical_frame"/>
  </joint>
  <link name="camera_color_optical_frame"/>

</robot>
