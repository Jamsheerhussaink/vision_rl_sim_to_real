<?xml version="1.0" ?>
<!-- ============================================================================== -->
<!-- Table URDF (Sim-to-Real Workbench)                                            -->
<!-- Specifications:                                                               -->
<!--   Tabletop: Dark Green Cutting Mat (rgba: 0.18 0.37 0.24 1.0)                 -->
<!--   Legs: 4 Matte Black Cylindrical Legs                                       -->
<!--   Dimensions: Length 1.20m x Width 1.00m x Height 0.40m                       -->
<!--   Construction: Solid tabletop slab with 4 supporting corner legs             -->
<!--   Mass: ~15 kg (rigid static foundation)                                      -->
<!-- ============================================================================== -->
<robot name="green_table">

  <material name="dark_green_mat">
    <color rgba="0.08 0.22 0.12 1.0"/>
  </material>

  <material name="matte_black_leg">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>

  <!-- Base link at floor level (Z = 0) -->
  <link name="table_base_link"/>

  <!-- Tabletop Link (Center at Z = 0.385m, top surface at Z = 0.40m) -->
  <joint name="table_top_joint" type="fixed">
    <origin xyz="0 0 0.385" rpy="0 0 0"/>
    <parent link="table_base_link"/>
    <child link="table_top_link"/>
  </joint>

  <link name="table_top_link">
    <!-- Visual Tabletop Slab (1.20m x 1.00m x 0.03m) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.20 1.00 0.03"/>
      </geometry>
      <material name="dark_green_mat"/>
    </visual>

    <!-- Collision Tabletop Slab -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="1.20 1.00 0.03"/>
      </geometry>
    </collision>

    <!-- 1. Front-Left Leg (Radius: 2.5cm, Height: 37cm, resting on floor) -->
    <visual>
      <origin xyz="0.52 0.42 -0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.37"/>
      </geometry>
      <material name="matte_black_leg"/>
    </visual>
    <collision>
      <origin xyz="0.52 0.42 -0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.37"/>
      </geometry>
    </collision>

    <!-- 2. Front-Right Leg -->
    <visual>
      <origin xyz="0.52 -0.42 -0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.37"/>
      </geometry>
      <material name="matte_black_leg"/>
    </visual>
    <collision>
      <origin xyz="0.52 -0.42 -0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.37"/>
      </geometry>
    </collision>

    <!-- 3. Back-Left Leg -->
    <visual>
      <origin xyz="-0.52 0.42 -0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.37"/>
      </geometry>
      <material name="matte_black_leg"/>
    </visual>
    <collision>
      <origin xyz="-0.52 0.42 -0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.37"/>
      </geometry>
    </collision>

    <!-- 4. Back-Right Leg -->
    <visual>
      <origin xyz="-0.52 -0.42 -0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.37"/>
      </geometry>
      <material name="matte_black_leg"/>
    </visual>
    <collision>
      <origin xyz="-0.52 -0.42 -0.20" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.025" length="0.37"/>
      </geometry>
    </collision>

    <!-- Inertial properties for sturdy 15kg table -->
    <inertial>
      <mass value="15.0"/>
      <origin xyz="0 0 -0.10" rpy="0 0 0"/>
      <inertia ixx="1.45" ixy="0.0" ixz="0.0"
               iyy="2.05" iyz="0.0"
               izz="3.20"/>
    </inertial>
  </link>

</robot>
