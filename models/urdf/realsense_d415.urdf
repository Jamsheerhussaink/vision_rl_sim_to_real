<?xml version="1.0" ?>
<!-- ============================================================================== -->
<!-- Intel RealSense D415 Camera URDF                                              -->
<!-- Specifications:                                                               -->
<!--   Dimensions: 99mm (W) x 20mm (D) x 23mm (H)                                  -->
<!--   Weight: ~72 grams                                                           -->
<!--   RGB Sensor: Horizontal FOV ~69.4 deg, Vertical FOV ~42.5 deg                 -->
<!--   Stereo Baseline: 55mm                                                       -->
<!-- ============================================================================== -->
<robot name="sensor_d415">

  <material name="d415_aluminum">
    <color rgba="0.75 0.75 0.78 1.0"/>
  </material>

  <material name="d415_lens_glass">
    <color rgba="0.1 0.1 0.15 1.0"/>
  </material>

  <!-- Base link at camera tripod mounting hole (1/4-20 UNC) -->
  <link name="camera_bottom_screw_frame"/>

  <joint name="camera_link_joint" type="fixed">
    <origin xyz="0 0.010 0.0115" rpy="0 0 0"/>
    <parent link="camera_bottom_screw_frame"/>
    <child link="camera_link"/>
  </joint>

  <!-- Physical Camera Body -->
  <link name="camera_link">
    <visual>
      <!-- Camera aluminum housing: 99mm x 20mm x 23mm -->
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.099 0.020 0.023"/>
      </geometry>
      <material name="d415_aluminum"/>
    </visual>
    
    <!-- Front optical window glass -->
    <visual>
      <origin xyz="0 0.0105 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.088 0.002 0.016"/>
      </geometry>
      <material name="d415_lens_glass"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.099 0.020 0.023"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.072"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <!-- Solid box inertia: Ixx=m/12*(d^2+h^2), Iyy=m/12*(w^2+h^2), Izz=m/12*(w^2+d^2) -->
      <inertia ixx="5.57e-06" ixy="0.0" ixz="0.0"
               iyy="6.08e-05" iyz="0.0"
               izz="6.12e-05"/>
    </inertial>
  </link>

  <!-- RGB Color Camera Optical Center -->
  <!-- On D415, color sensor is located at X = +15mm from center -->
  <joint name="camera_color_joint" type="fixed">
    <origin xyz="0.015 0.011 0" rpy="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_color_frame"/>
  </joint>
  <link name="camera_color_frame"/>

  <joint name="camera_color_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    <parent link="camera_color_frame"/>
    <child link="camera_color_optical_frame"/>
  </joint>
  <link name="camera_color_optical_frame"/>

  <!-- Depth Camera Optical Center (Left IR Imager) -->
  <!-- D415 left IR camera is at X = -20mm from center -->
  <joint name="camera_depth_joint" type="fixed">
    <origin xyz="-0.020 0.011 0" rpy="0 0 0"/>
    <parent link="camera_link"/>
    <child link="camera_depth_frame"/>
  </joint>
  <link name="camera_depth_frame"/>

  <joint name="camera_depth_optical_joint" type="fixed">
    <origin xyz="0 0 0" rpy="-1.5707963 0 -1.5707963"/>
    <parent link="camera_depth_frame"/>
    <child link="camera_depth_optical_frame"/>
  </joint>
  <link name="camera_depth_optical_frame"/>

</robot>
