<mujoco model="so101_pick_place_scene">
  <compiler angle="radian" meshdir="../../assets" autolimits="true"/>

  <option timestep="0.002" iterations="50" solver="Newton" gravity="0 0 -9.81"/>

  <visual>
    <!-- Ambient Room Lighting & Headlight settings -->
    <headlight diffuse="0.45 0.45 0.45" ambient="0.35 0.35 0.35" specular="0.05 0.05 0.05"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="130" elevation="-25"/>
    <quality shadowsize="2048"/>
  </visual>

  <!-- Default visual center for interactive viewer -->
  <statistic center="0.25 0 0.45" extent="0.8"/>

  <worldbody>
    <!-- Studio / Lab Floor at z=0 with collision -->
    <geom name="floor" type="plane" size="5.0 5.0 0.05" rgba="0.88 0.88 0.88 1" 
          contype="1" conaffinity="1" friction="1 0.005 0.0001"/>

    <!-- Soft Lab Background Wall at back of room -->
    <geom name="back_wall" type="box" size="2.5 0.05 1.5" pos="0.25 -1.2 1.5" 
          rgba="0.92 0.92 0.94 1" contype="0" conaffinity="0"/>

    <!-- ========================================================================= -->
    <!-- REALISTIC ROOM LIGHTING SETUP                                             -->
    <!-- ========================================================================= -->
    <!-- Primary Ceiling Overhead Light (simulating soft LED panel / ceiling luminaire) -->
    <light name="ceiling_key_light" pos="0.30 0.10 1.60" dir="-0.08 -0.05 -1.0" 
           directional="true" diffuse="0.85 0.85 0.82" specular="0.25 0.25 0.25" castshadow="true"/>

    <!-- Secondary Soft Fill Light (angled from left-back to eliminate pitch-black shadows) -->
    <light name="room_fill_light" pos="-0.40 -0.40 1.20" dir="0.50 0.40 -0.80" 
           directional="true" diffuse="0.35 0.35 0.38" specular="0.05 0.05 0.05" castshadow="false"/>

    <!-- ========================================================================= -->
    <!-- CALIBRATED DEPTH CAMERA SETUP (EYE-TO-HAND WORKSPACE MOUNT)                -->
    <!-- ========================================================================= -->
    <!-- 
      Recommended mounting coordinates for RealSense D435 / D405 / OAK-D:
      - Pos: X = 0.42m, Y = 0.30m, Z = 0.68m
      - Target: Center of manipulation area [X=0.28, Y=-0.03, Z=0.41]
      - Working distance: 0.45m (optimal SNR, minimal noise & no arm occlusion)
      - Vertical FOV: 58 deg (standard RealSense D435 fovy)
    -->
    <!-- Intel RealSense D415 RGB Camera (matching env final.png) -->
    <camera name="realsense_d415_rgb" pos="0.12 -0.38 0.82" xyaxes="0.9790 -0.2040 0.0000 0.1327 0.6369 0.7595" fovy="42.5"/>

    <!-- Front angled camera for secondary inspection / recording -->
    <camera name="front_cam" 
            pos="0.60 0.0 0.65" 
            xyaxes="0.0 1.0 0.0 -0.5547 0.0 0.8321" 
            fovy="50"/>

    <!-- Top-down orthogonal tracking camera -->
    <camera name="top_cam" 
            pos="0.28 0.0 0.90" 
            xyaxes="0 1 0 -1 0 0" 
            fovy="60"/>
  </worldbody>

  <!-- Include all modular environment and robot assets -->
  <include file="so101.xml"/>
  <include file="table.xml"/>
  <include file="cube.xml"/>
  <include file="box.xml"/>
</mujoco>
