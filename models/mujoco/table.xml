<mujoco model="table">
  <asset>
    <!-- Deep Dark Green Cutting Mat / Tabletop Material matching real photo -->
    <material name="table_top_mat" rgba="0.08 0.22 0.12 1.0" specular="0.06" shininess="0.1" reflectance="0.01"/>
    <!-- Black Legs Material -->
    <material name="table_leg_mat" rgba="0.08 0.08 0.08 1.0" specular="0.15" shininess="0.2" reflectance="0.01"/>
  </asset>

  <worldbody>
    <!-- Large dark green tabletop covering the entire camera FOV (surface at z = 0.40m) -->
    <!-- Table center pos: x=0.25m, y=0.0m, z=0.385m (half-thickness 0.015m -> top at z=0.40m) -->
    <body name="table" pos="0.25 0 0.385">
      <!-- Full Dark Green Tabletop (3.0m x 3.0m) to fill camera frame completely -->
      <geom name="table_top" type="box" size="2.50 2.50 0.015" pos="0 0 0" 
            material="table_top_mat" contype="1" conaffinity="1" friction="1.0 0.005 0.0001"/>
      
      <!-- 4 Black Legs (Medium height: resting firmly on floor z=0) -->
      <geom name="leg_fl" type="cylinder" size="0.025 0.185" pos="0.80 0.80 -0.20" 
            material="table_leg_mat" contype="1" conaffinity="1"/>
      <geom name="leg_fr" type="cylinder" size="0.025 0.185" pos="0.80 -0.80 -0.20" 
            material="table_leg_mat" contype="1" conaffinity="1"/>
      <geom name="leg_bl" type="cylinder" size="0.025 0.185" pos="-0.80 0.80 -0.20" 
            material="table_leg_mat" contype="1" conaffinity="1"/>
      <geom name="leg_br" type="cylinder" size="0.025 0.185" pos="-0.80 -0.80 -0.20" 
            material="table_leg_mat" contype="1" conaffinity="1"/>
    </body>
  </worldbody>
</mujoco>
