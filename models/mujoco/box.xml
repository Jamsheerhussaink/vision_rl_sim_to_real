<mujoco model="box">
  <asset>
    <!-- Matte Cardboard Brown Material matching real box -->
    <material name="cardboard_outer_mat" rgba="0.74 0.54 0.35 1.0" specular="0.08" shininess="0.1"/>
    <material name="cardboard_tape_mat" rgba="0.88 0.86 0.80 1.0" specular="0.1" shininess="0.2"/>
  </asset>

  <worldbody>
    <!-- Cardboard Box placed on dark green table (table surface at z=0.40m) -->
    <!-- Dimensions: Height = 8cm, Length = 20cm, Width = 15cm (Calibrated against env final.png) -->
    <body name="target_box" pos="0.22 0.25 0.40" quat="0.9990 0 0 -0.0436">
      <!-- 1. Box Bottom Plate (20cm x 15cm x 4mm) resting on table -->
      <geom name="box_bottom" type="box" size="0.10 0.075 0.002" pos="0 0 0.002" 
            material="cardboard_outer_mat" mass="0.030" contype="1" conaffinity="1" friction="0.8 0.005 0.0001"/>
      
      <!-- 2. Front Wall (-Y, Length: 20cm, Height: 8cm) -->
      <geom name="box_wall_front" type="box" size="0.10 0.002 0.04" pos="0 -0.073 0.04" 
            material="cardboard_outer_mat" mass="0.012" contype="1" conaffinity="1" friction="0.8 0.005 0.0001"/>
      
      <!-- 3. Back Wall (+Y, Length: 20cm, Height: 8cm) -->
      <geom name="box_wall_back" type="box" size="0.10 0.002 0.04" pos="0 0.073 0.04" 
            material="cardboard_outer_mat" mass="0.012" contype="1" conaffinity="1" friction="0.8 0.005 0.0001"/>
      
      <!-- 4. Left Wall (-X, Width: 15cm, Height: 8cm) with white corner tape accent -->
      <geom name="box_wall_left" type="box" size="0.002 0.071 0.04" pos="-0.098 0 0.04" 
            material="cardboard_tape_mat" mass="0.012" contype="1" conaffinity="1" friction="0.8 0.005 0.0001"/>
      
      <!-- 5. Right Wall (+X, Width: 15cm, Height: 8cm) -->
      <geom name="box_wall_right" type="box" size="0.002 0.071 0.04" pos="0.098 0 0.04" 
            material="cardboard_outer_mat" mass="0.012" contype="1" conaffinity="1" friction="0.8 0.005 0.0001"/>
    </body>
  </worldbody>
</mujoco>
